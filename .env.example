POSTGRES_DB=job_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=job_intelligence_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:job_intelligence_dev@jobs_db:5432/job_intelligence

# Raw snapshots stay local by default; no AWS access is needed in local mode.
RAW_STORAGE=local
# Required only when RAW_STORAGE=s3. Use an existing bucket and a least-privilege IAM role.
S3_BUCKET=replace-with-s3-bucket
S3_PREFIX=raw/
AWS_DEFAULT_REGION=us-east-1
